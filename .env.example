# [TODO] Add to .gitignore
# Select "mock" for local development without credentials or "oanda" for OANDA Practice.
FXAI_MARKET_PROVIDER=oanda
FXAI_PRICE_POLL_INTERVAL=15000
OANDA_API_TOKEN=replace-with-your-oanda-practice-token
OANDA_ACCOUNT_ID=replace-with-your-oanda-practice-account-id
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_CONNECTION_TIMEOUT=2s
OANDA_REQUEST_TIMEOUT=5s

# Optional local frontend origin.
FXAI_CORS_ALLOWED_ORIGIN=http://localhost:5173

# PostgreSQL/TimescaleDB. Replace the password for your local environment.
FXAI_DATABASE_NAME=fxai
FXAI_DATABASE_USERNAME=fxai
FXAI_DATABASE_PASSWORD=replace-with-local-database-password
FXAI_DATABASE_PORT=5433
FXAI_DATABASE_URL=jdbc:postgresql://localhost:5433/fxai

# Redis latest-price cache. Redis is optional at runtime; provider requests continue if it is unavailable.
FXAI_REDIS_HOST=localhost
FXAI_REDIS_PORT=6379
FXAI_REDIS_CONNECT_TIMEOUT=500ms
FXAI_REDIS_TIMEOUT=500ms
FXAI_LATEST_PRICE_CACHE_TTL=5s

# Kafka KRaft: host-run backend uses localhost; container clients use kafka:19092.
FXAI_KAFKA_PORT=9092
FXAI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FXAI_KAFKA_PARTITIONS=3
FXAI_KAFKA_REPLICAS=1
FXAI_KAFKA_REDIS_GROUP=fxai-latest-price-v1
# Use a distinct, stable group per backend instance serving WebSocket sessions.
FXAI_KAFKA_WEBSOCKET_GROUP=fxai-websocket-local-v1
FXAI_KAFKA_RETRY_INTERVAL=1000
FXAI_KAFKA_RETRY_ATTEMPTS=3
FXAI_KAFKA_LOG_LEVEL=INFO
FXAI_KAFKA_CREATE_TOPICS=true
FXAI_KAFKA_LISTENERS_ENABLED=true
