# Select "mock" for local development without credentials or "oanda" for OANDA Practice.
FXAI_MARKET_PROVIDER=oanda
OANDA_API_TOKEN=replace-with-your-oanda-practice-token
OANDA_ACCOUNT_ID=replace-with-your-oanda-practice-account-id
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_CONNECTION_TIMEOUT=2s
OANDA_REQUEST_TIMEOUT=5s

# Optional local frontend origin.
FXAI_CORS_ALLOWED_ORIGIN=http://localhost:5173
